    <!-- SCRIPTS DINÁMICOS -->
    <script is:inline define:vars={{ rodsData, linesData, bobbersData, enchantmentsData }}>
      const RARITY_BASE = {
        Trash: 9.00, Abundant: 27.00, Common: 25.00, Curious: 18.00,
        Elusive: 11.00, Fabled: 4.40, Mythic: 2.50, Exotic: 0.085,
        Relic: 2.50, Secret: 0.01, UltimateSecret: 0.005
      };

      const RARITY_EXP = {
        Trash: -1.0, Abundant: -1.2, Common: -0.8, Curious: 0.2,
        Elusive: 0.5, Fabled: 0.85, Mythic: 1.05, Exotic: 1.20,
        Relic: 0.0, Secret: 1.22, UltimateSecret: 1.26
      };

      const RARITY_CLASSES = {
        Trash: "rarity-trash",
        Abundant: "rarity-abundant",
        Common: "rarity-common",
        Curious: "rarity-curious",
        Elusive: "rarity-elusive",
        Fabled: "rarity-fabled",
        Mythic: "rarity-mythic",
        Exotic: "rarity-exotic",
        Relic: "rarity-relic",
        Secret: "rarity-secret",
        UltimateSecret: "rarity-ultimate-secret"
      };

      let activeStat = 'balance';

      document.querySelectorAll('.island-nav-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('.island-nav-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.island-view').forEach(v => v.classList.remove('active'));

          const target = e.currentTarget;
          target.classList.add('active');
          const viewId = target.dataset.target;
          document.getElementById(viewId)?.classList.add('active');
        });
      });

      const searchInput = document.getElementById('fish-search-input');
      const islandFilter = document.getElementById('fish-island-filter');
      const rarityFilter = document.getElementById('fish-rarity-filter');
      const waterFilter = document.getElementById('fish-water-filter');
      const tableRows = document.querySelectorAll('.fish-row');

      function filterFishTable() {
        const query = searchInput.value.toLowerCase().trim();
        const selectedIsland = islandFilter.value;
        const selectedRarity = rarityFilter.value;
        const selectedWater = waterFilter.value;

        tableRows.forEach(row => {
          const name = row.dataset.name;
          const island = row.dataset.island;
          const rarity = row.dataset.rarity;
          const water = row.dataset.water;

          const matchesQuery = !query || name.includes(query) || island.toLowerCase().includes(query);
          const matchesIsland = selectedIsland === 'ALL' || island === selectedIsland;
          const matchesRarity = selectedRarity === 'ALL' || rarity.toLowerCase() === selectedRarity.toLowerCase();
          const matchesWater = selectedWater === 'ALL' || water.toLowerCase().includes(selectedWater.toLowerCase());

          if (matchesQuery && matchesIsland && matchesRarity && matchesWater) {
            row.style.display = '';
          } else {
            row.style.display = 'none';
          }
        });
      }

      [searchInput, islandFilter, rarityFilter, waterFilter].forEach(el => {
        el?.addEventListener('input', filterFishTable);
        el?.addEventListener('change', filterFishTable);
      });

      function parseVal(s) {
        if (!s || s === '-') return 0;
        return parseFloat(String(s).replace('%', '').replace('+', '').replace(/,/g, '').trim()) || 0;
      }

      function parseWeight(s) {
        if (!s || s === '-') return 0;
        return parseFloat(String(s).toLowerCase().replace('kg', '').replace(/,/g, '').replace('+', '').trim()) || 0;
      }

      function getStatValue(item, stat) {
        if (!item) return 0;
        if (stat === 'maxWeight') return parseWeight(item.maxWeight);
        if (stat === 'strength') return parseVal(item.strength) + parseVal(item.expertise);
        return parseVal(item[stat]);
      }

      function calculateBalanceScore(item, enchant = null) {
        const luck = parseVal(item.luck) + (enchant ? parseVal(enchant.luck) : 0);
        const attr = parseVal(item.attractionRate) + (enchant ? parseVal(enchant.attractionRate) : 0);
        const str = parseVal(item.strength) + (enchant ? parseVal(enchant.strength) : 0);
        const exp = parseVal(item.expertise) + (enchant ? parseVal(enchant.expertise) : 0);
        const bigC = parseVal(item.bigCatchRate) + (enchant ? parseVal(enchant.bigCatchRate) : 0);
        const weight = parseWeight(item.maxWeight) + (enchant ? parseWeight(enchant.maxWeight) : 0);

        // Ponderación de Nivelación & Poder Realista (Levelling Speed & Efficiency Index)
        // 1. Suerte: Escala la probabilidad de peces raros/míticos (Gran fuente de XP por captura).
        const luckScore = luck >= 0 ? luck * 0.8 : luck * 1.5;

        // 2. Tasa de Atracción (Velocidad): Aumenta capturas/hora (Velocidad de subida de nivel).
        const attrScore = attr >= 0 ? attr * 1.4 : attr * 2.0;

        // 3. Minijuego (Fuerza + Pericia): Facilidad al recoger peces pesados sin fallar.
        const miniGameScore = (Math.max(0, str) + Math.max(0, exp)) * 0.5;

        // 4. Peces Grandes (Big Catch Rate): Multiplicador de peso y experiencia por captura.
        const bigCatchScore = bigC * 0.35;

        // 5. Peso Máximo: Escala logarítmica (Permite pescar monstruos marinos de gran XP sin romper línea).
        const weightScore = weight > 0 ? Math.log10(Math.max(10, weight)) * 12 : 0;

        return luckScore + attrScore + miniGameScore + bigCatchScore + weightScore;
      }

      function optimize() {
        const ownedRodCheckboxes = Array.from(document.querySelectorAll('.rod-inv-check:checked'));
        const ownedRodsWithEnchants = ownedRodCheckboxes.map(cb => {
          const rodIdx = parseInt(cb.dataset.idx);
          const rod = rodsData[rodIdx];
          const select = document.querySelector(`.island-enchant-select[data-rod-idx="${rodIdx}"]`);
          const enchIdx = select ? parseInt(select.value) : 0;
          const enchant = enchantmentsData[enchIdx] || enchantmentsData[0];
          return { rod, enchant, rodIdx };
        });

        const ownedLines = Array.from(document.querySelectorAll('.line-inv-check:checked'))
          .map(cb => linesData[parseInt(cb.dataset.idx)]);
        const ownedBobbers = Array.from(document.querySelectorAll('.bobber-inv-check:checked'))
          .map(cb => bobbersData[parseInt(cb.dataset.idx)]);

        const islands = parseInt(document.getElementById('islands-input').value) || 0;
        const budget = parseFloat(document.getElementById('budget-input').value) || 0;

        let bestRodCombo, bestLine, bestBobber;

        if (activeStat === 'balance') {
          bestRodCombo = ownedRodsWithEnchants.sort((a, b) => calculateBalanceScore(b.rod, b.enchant) - calculateBalanceScore(a.rod, a.enchant))[0] || { rod: rodsData[0], enchant: enchantmentsData[0], rodIdx: 0 };
          bestLine = ownedLines.sort((a, b) => calculateBalanceScore(b) - calculateBalanceScore(a))[0] || linesData[0];
          bestBobber = ownedBobbers.sort((a, b) => calculateBalanceScore(b) - calculateBalanceScore(a))[0] || bobbersData[0];
        } else {
          bestRodCombo = ownedRodsWithEnchants.sort((a, b) => {
            const scoreA = getStatValue(a.rod, activeStat) + getStatValue(a.enchant, activeStat);
            const scoreB = getStatValue(b.rod, activeStat) + getStatValue(b.enchant, activeStat);
            return scoreB - scoreA;
          })[0] || { rod: rodsData[0], enchant: enchantmentsData[0], rodIdx: 0 };

          bestLine = ownedLines.sort((a, b) => getStatValue(b, activeStat) - getStatValue(a, activeStat))[0] || linesData[0];
          bestBobber = ownedBobbers.sort((a, b) => getStatValue(b, activeStat) - getStatValue(a, activeStat))[0] || bobbersData[0];
        }

        const totalLuck = parseVal(bestRodCombo.rod.luck) + parseVal(bestRodCombo.enchant.luck) + parseVal(bestLine.luck) + parseVal(bestBobber.luck) + (islands * 15);
        const totalAttraction = Math.min(100, Math.max(0, parseVal(bestRodCombo.rod.attractionRate) + parseVal(bestRodCombo.enchant.attractionRate) + parseVal(bestLine.attractionRate) + parseVal(bestBobber.attractionRate)));
        const totalStrength = parseVal(bestRodCombo.rod.strength) + parseVal(bestRodCombo.enchant.strength) + parseVal(bestLine.strength) + parseVal(bestBobber.strength);
        const totalExpertise = parseVal(bestRodCombo.rod.expertise) + parseVal(bestRodCombo.enchant.expertise) + parseVal(bestLine.expertise) + parseVal(bestBobber.expertise);
        const totalBigCatch = parseVal(bestRodCombo.rod.bigCatchRate) + parseVal(bestRodCombo.enchant.bigCatchRate) + parseVal(bestLine.bigCatchRate) + parseVal(bestBobber.bigCatchRate);
        const totalWeight = parseWeight(bestRodCombo.rod.maxWeight) + parseWeight(bestRodCombo.enchant.maxWeight);

        document.getElementById('opt-title').textContent = `${bestRodCombo.rod.name} + ${bestLine.name}`;
        document.getElementById('opt-rod').textContent = bestRodCombo.rod.name;
        document.getElementById('opt-enchant').textContent = bestRodCombo.enchant.name;
        document.getElementById('opt-line').textContent = bestLine.name;
        document.getElementById('opt-bobber').textContent = bestBobber.name;

        if (activeStat === 'balance') {
          const totalBalanceScore = calculateBalanceScore(bestRodCombo.rod, bestRodCombo.enchant) + calculateBalanceScore(bestLine) + calculateBalanceScore(bestBobber) + (islands * 15 * 0.8);
          document.getElementById('opt-total-stat').textContent = `Score: ${Math.round(totalBalanceScore)}`;
        } else {
          const isPercent = activeStat === 'attractionRate';
          const bestStatScore = getStatValue(bestRodCombo.rod, activeStat) + getStatValue(bestRodCombo.enchant, activeStat) + getStatValue(bestLine, activeStat) + getStatValue(bestBobber, activeStat) + (activeStat === 'luck' ? islands * 15 : 0);
          document.getElementById('opt-total-stat').textContent = `${bestStatScore >= 0 ? '+' : ''}${bestStatScore}${isPercent ? '%' : ''}`;
        }

        // EVALUACIÓN DE LA RUTA DEL ALTAR (MEJOR ENCANTAMIENTO PARA LA CAÑA ACTUAL)
		const targetEnchants = enchantmentsData
		.filter(e => e.name !== "Sin Encantamiento")
		.map(e => {
			let score = 0;
			if (activeStat === 'balance') {
			score = calculateBalanceScore(bestRodCombo.rod, e);
			} else {
			score = getStatValue(bestRodCombo.rod, activeStat) + getStatValue(e, activeStat);
			}
			return { ...e, score };
		})
		.sort((a, b) => b.score - a.score);

		const bestAltarEnch = targetEnchants[0];

		if (bestAltarEnch) {
		document.getElementById('altar-ench-name').textContent = bestAltarEnch.name;
		document.getElementById('altar-target-rarity').textContent = bestAltarEnch.rarity;
		document.getElementById('altar-target-rod').textContent = bestRodCombo.rod.name;
		document.getElementById('altar-ench-effect').textContent = bestAltarEnch.description || bestAltarEnch.specialEffect || '-';
		}

        // EVALUACIÓN DE LA RUTA DE TIENDA (MEJOR MEJORA EN TIENDA DISPONIBLE)
        const candidates = [];

        function evalShopItem(item, type, categoryLabel, icon, idx) {
          let isOwned = false;
          if (type === 'rod') {
            isOwned = !!document.querySelector(`.rod-inv-check[data-idx="${idx}"]:checked`);
          } else if (type === 'line') {
            isOwned = !!document.querySelector(`.line-inv-check[data-idx="${idx}"]:checked`);
          } else if (type === 'bobber') {
            isOwned = !!document.querySelector(`.bobber-inv-check[data-idx="${idx}"]:checked`);
          }

          if (isOwned) return;

          let newScore = 0;
          let currScore = 0;

          if (type === 'rod') {
            if (activeStat === 'balance') {
              newScore = calculateBalanceScore(item, bestRodCombo.enchant) + calculateBalanceScore(bestLine) + calculateBalanceScore(bestBobber);
              currScore = calculateBalanceScore(bestRodCombo.rod, bestRodCombo.enchant) + calculateBalanceScore(bestLine) + calculateBalanceScore(bestBobber);
            } else {
              newScore = getStatValue(item, activeStat) + getStatValue(bestRodCombo.enchant, activeStat) + getStatValue(bestLine, activeStat) + getStatValue(bestBobber, activeStat);
              currScore = getStatValue(bestRodCombo.rod, activeStat) + getStatValue(bestRodCombo.enchant, activeStat) + getStatValue(bestLine, activeStat) + getStatValue(bestBobber, activeStat);
            }
          } else if (type === 'line') {
            if (activeStat === 'balance') {
              newScore = calculateBalanceScore(bestRodCombo.rod, bestRodCombo.enchant) + calculateBalanceScore(item) + calculateBalanceScore(bestBobber);
              currScore = calculateBalanceScore(bestRodCombo.rod, bestRodCombo.enchant) + calculateBalanceScore(bestLine) + calculateBalanceScore(bestBobber);
            } else {
              newScore = getStatValue(bestRodCombo.rod, activeStat) + getStatValue(bestRodCombo.enchant, activeStat) + getStatValue(item, activeStat) + getStatValue(bestBobber, activeStat);
              currScore = getStatValue(bestRodCombo.rod, activeStat) + getStatValue(bestRodCombo.enchant, activeStat) + getStatValue(bestLine, activeStat) + getStatValue(bestBobber, activeStat);
            }
          } else if (type === 'bobber') {
            if (activeStat === 'balance') {
              newScore = calculateBalanceScore(bestRodCombo.rod, bestRodCombo.enchant) + calculateBalanceScore(bestLine) + calculateBalanceScore(item);
              currScore = calculateBalanceScore(bestRodCombo.rod, bestRodCombo.enchant) + calculateBalanceScore(bestLine) + calculateBalanceScore(bestBobber);
            } else {
              newScore = getStatValue(bestRodCombo.rod, activeStat) + getStatValue(bestRodCombo.enchant, activeStat) + getStatValue(bestLine, activeStat) + getStatValue(item, activeStat);
              currScore = getStatValue(bestRodCombo.rod, activeStat) + getStatValue(bestRodCombo.enchant, activeStat) + getStatValue(bestLine, activeStat) + getStatValue(bestBobber, activeStat);
            }
          }

          const gain = newScore - currScore;
          candidates.push({ item, type, categoryLabel, icon, idx, gain, canAfford: budget >= item.costNum });
        }

        rodsData.forEach((r, idx) => evalShopItem(r, 'rod', 'Caña', '🎣', idx));
        linesData.forEach((l, idx) => evalShopItem(l, 'line', 'Línea', '🧵', idx));
        bobbersData.forEach((b, idx) => evalShopItem(b, 'bobber', 'Boya', '🎈', idx));

        const affordableBest = candidates.filter(c => c.gain > 0 && c.canAfford).sort((a, b) => b.gain - a.gain)[0];
        const unaffordableBest = candidates.filter(c => c.gain > 0 && !c.canAfford).sort((a, b) => a.item.costNum - b.item.costNum || b.gain - a.gain)[0];

        const bestUpgrade = affordableBest || unaffordableBest;

        if (bestUpgrade) {
          const isPercent = activeStat === 'attractionRate';
          const unitStr = isPercent ? '%' : '';
          const gainValStr = `${bestUpgrade.gain >= 0 ? '+' : ''}${bestUpgrade.gain.toFixed(0)}${unitStr}`;

          document.getElementById('next-gain').textContent = gainValStr;
          document.getElementById('next-img-slot').textContent = bestUpgrade.icon;
          document.getElementById('next-name').textContent = bestUpgrade.item.name;
          document.getElementById('next-type').textContent = `${bestUpgrade.categoryLabel} • ${bestUpgrade.item.location}`;
          document.getElementById('next-loc').textContent = bestUpgrade.item.location;
          document.getElementById('next-price').textContent = bestUpgrade.item.price;

          const affordEl = document.getElementById('next-afford-status');
          if (bestUpgrade.canAfford) {
            affordEl.textContent = `🟢 ¡Comprar ya! ($${budget.toLocaleString()} disp.)`;
            affordEl.style.color = '#4ef2bb';
          } else {
            const diff = bestUpgrade.item.costNum - budget;
            affordEl.textContent = `🔴 Te faltan $${diff.toLocaleString()}`;
            affordEl.style.color = '#f43f5e';
          }
        } else {
          document.getElementById('next-gain').textContent = 'MAX';
          document.getElementById('next-img-slot').textContent = '👑';
          document.getElementById('next-name').textContent = '¡Equipo Completo!';
          document.getElementById('next-type').textContent = 'Todas las mejoras de tienda adquiridas';
          document.getElementById('next-loc').textContent = 'Mochila al 100%';
          document.getElementById('next-price').textContent = '$0';
          const affordEl = document.getElementById('next-afford-status');
          affordEl.textContent = '⭐ Tienes todo el equipo en tu mochila';
          affordEl.style.color = '#ffd166';
        }

        renderShopCards();

        // Tiempos y Telemetría
        const waitTime = Math.max(0, 14.0 * (1 - totalAttraction / 100));
        const cycleTime = parseFloat((waitTime + 3.5 + 1.5).toFixed(2));
        const catchesHr = Math.round(3600 / cycleTime);

        document.getElementById('disp-luck').textContent = (totalLuck >= 0 ? '+' : '') + totalLuck;
        document.getElementById('disp-attraction').textContent = totalAttraction + '%';
        document.getElementById('disp-minigame').textContent = `${totalStrength + totalExpertise} (Str ${totalStrength} / Exp ${totalExpertise})`;
        document.getElementById('disp-catches').textContent = catchesHr;
        document.getElementById('disp-weight').textContent = totalWeight.toLocaleString() + ' kg';
        document.getElementById('disp-bigcatch').textContent = (totalBigCatch >= 0 ? '+' : '') + totalBigCatch;

        // Distribución
        const luckMultiplier = Math.max(0.01, 1 + (totalLuck / 100));
        document.getElementById('disp-luck-mult').textContent = 'Multiplicador: ' + luckMultiplier.toFixed(2) + 'x';

        let totalPool = 0;
        const adjWeights = {};
        for (const [r, base] of Object.entries(RARITY_BASE)) {
          const exp = RARITY_EXP[r] || 0;
          const w = base * Math.pow(luckMultiplier, exp);
          adjWeights[r] = w;
          totalPool += w;
        }

        const container = document.getElementById('rarity-container');
        container.innerHTML = '';
        for (const [r, w] of Object.entries(adjWeights)) {
          const pct = ((w / totalPool) * 100);
          const formatted = pct < 0.01 ? pct.toFixed(4) : pct.toFixed(2);
          const card = document.createElement('div');
          card.className = `island-rarity-card ${RARITY_CLASSES[r] || 'rarity-trash'}`;
          card.innerHTML = `<span class="island-rarity-name">${r}</span>` +
                           `<span class="island-rarity-val">${formatted}%</span>` +
                           `<span class="island-rarity-base">Base: ${RARITY_BASE[r]}%</span>`;
          container.appendChild(card);
        }
      }

      function renderShopCards() {
        const container = document.getElementById('shop-cards-container');
        if (!container) return;

        const query = document.getElementById('shop-search-input')?.value.toLowerCase().trim() || '';
        const locFilter = document.getElementById('shop-location-filter')?.value || 'ALL';
        const catFilter = document.getElementById('shop-category-filter')?.value || 'ALL';
        const budgetVal = parseFloat(document.getElementById('budget-input')?.value) || 0;

        const allItems = [
          ...rodsData.map((r, i) => ({ ...r, type: 'rod', categoryLabel: 'Caña', icon: '🎣', origIdx: i })),
          ...linesData.map((l, i) => ({ ...l, type: 'line', categoryLabel: 'Línea', icon: '🧵', origIdx: i })),
          ...bobbersData.map((b, i) => ({ ...b, type: 'bobber', categoryLabel: 'Boya', icon: '🎈', origIdx: i }))
        ];

        container.innerHTML = '';

        allItems.forEach(item => {
          const nameLower = item.name.toLowerCase();
          const locLower = item.location.toLowerCase();

          const matchesQuery = !query || nameLower.includes(query) || locLower.includes(query);
          
          let matchesLoc = true;
          if (locFilter === 'SPECIAL') {
            matchesLoc = !['coconut bay', 'crescent isle', 'tanglewood', 'luxian dunes', 'twilight realm'].includes(locLower);
          } else if (locFilter !== 'ALL') {
            matchesLoc = locLower.includes(locFilter.toLowerCase());
          }

          const matchesCat = catFilter === 'ALL' || item.type === catFilter;

          if (!matchesQuery || !matchesLoc || !matchesCat) return;

          let isOwned = false;
          let checkSelector = '';
          if (item.type === 'rod') checkSelector = `.rod-inv-check[data-idx="${item.origIdx}"]`;
          else if (item.type === 'line') checkSelector = `.line-inv-check[data-idx="${item.origIdx}"]`;
          else if (item.type === 'bobber') checkSelector = `.bobber-inv-check[data-idx="${item.origIdx}"]`;

          const checkEl = document.querySelector(checkSelector);
          if (checkEl) isOwned = checkEl.checked;

          const card = document.createElement('div');
          card.className = 'shop-item-card';

          const canAfford = budgetVal >= item.costNum;
          const priceColor = item.costNum === 0 ? '#4ef2bb' : (canAfford ? '#ffd166' : '#f43f5e');

          const statPills = [];
          if (item.luck && item.luck !== '-') statPills.push(`<span class="shop-stat-chip" style="color: #ffd166;">🍀 ${item.luck} Suerte</span>`);
          if (item.attractionRate && item.attractionRate !== '-') statPills.push(`<span class="shop-stat-chip" style="color: #38efef;">⚡ ${item.attractionRate} Atracción</span>`);
          if (item.strength && item.strength !== '-') statPills.push(`<span class="shop-stat-chip" style="color: #a7f3d0;">💪 ${item.strength} Fuerza</span>`);
          if (item.expertise && item.expertise !== '-') statPills.push(`<span class="shop-stat-chip" style="color: #a7f3d0;">🧠 ${item.expertise} Pericia</span>`);
          if (item.bigCatchRate && item.bigCatchRate !== '-') statPills.push(`<span class="shop-stat-chip" style="color: #fde68a;">🐋 ${item.bigCatchRate} BigCatch</span>`);
          if (item.maxWeight && item.maxWeight !== '-') statPills.push(`<span class="shop-stat-chip" style="color: #67e8f9;">⚖️ ${item.maxWeight} MaxWeight</span>`);

          card.innerHTML = `
            <div>
              <div class="shop-item-header">
                <span class="shop-item-title">${item.icon} ${item.name}</span>
                <span class="shop-item-badge island-tag-cyan">${item.categoryLabel}</span>
              </div>
              <div style="margin-top: 6px; font-size: 12px;">
                <span style="color: #93c5b5;">Ubicación:</span> <strong style="color: #ffd166;">📍 ${item.location}</strong>
              </div>
              <div style="margin-top: 2px; font-size: 13px;">
                <span style="color: #93c5b5;">Precio:</span> <strong style="color: ${priceColor}; font-weight: 800;">${item.price}</strong>
              </div>
            </div>
            <div class="shop-item-stats">
              ${statPills.join('')}
            </div>
            <button class="shop-toggle-btn ${isOwned ? 'owned' : ''}" data-type="${item.type}" data-idx="${item.origIdx}">
              ${isOwned ? '✓ En tu Mochila' : '+ Añadir a Mochila'}
            </button>
          `;

          container.appendChild(card);
        });

        container.querySelectorAll('.shop-toggle-btn').forEach(btn => {
          btn.addEventListener('click', (e) => {
            const type = e.currentTarget.dataset.type;
            const idx = e.currentTarget.dataset.idx;
            let selector = '';
            if (type === 'rod') selector = `.rod-inv-check[data-idx="${idx}"]`;
            else if (type === 'line') selector = `.line-inv-check[data-idx="${idx}"]`;
            else if (type === 'bobber') selector = `.bobber-inv-check[data-idx="${idx}"]`;

            const cb = document.querySelector(selector);
            if (cb) {
              cb.checked = !cb.checked;
              optimize();
            }
          });
        });
      }

      ['shop-search-input', 'shop-location-filter', 'shop-category-filter'].forEach(id => {
        const el = document.getElementById(id);
        el?.addEventListener('input', renderShopCards);
        el?.addEventListener('change', renderShopCards);
      });

      document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.addEventListener('change', optimize));
      document.querySelectorAll('.island-enchant-select').forEach(sel => sel.addEventListener('change', optimize));
      document.getElementById('islands-input')?.addEventListener('input', optimize);
      document.getElementById('budget-input')?.addEventListener('input', optimize);

      document.querySelectorAll('.island-tab').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('.island-tab').forEach(b => b.classList.remove('active'));
          const target = e.currentTarget;
          target.classList.add('active');
          activeStat = target.dataset.stat;
          optimize();
        });
      });

      document.getElementById('btn-select-all')?.addEventListener('click', () => {
        document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = true);
        optimize();
      });

      document.getElementById('btn-select-basic')?.addEventListener('click', () => {
        document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = false);
        document.querySelector('.rod-inv-check[data-idx="0"]').checked = true;
        document.querySelector('.line-inv-check[data-idx="0"]').checked = true;
        document.querySelector('.bobber-inv-check[data-idx="0"]').checked = true;
        optimize();
      });

      optimize();
    </script>
  </body>
</html>