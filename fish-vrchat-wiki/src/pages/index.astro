<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FishVR - Official Loadout & Wiki</title>
  </head>
  <body>
    <div class="island-bg-glow"></div>

    <div class="island-container">
      
      <!-- TOP HEADER (FISHVR) -->
      <header class="island-card island-header">
        <div>
          <div class="island-badge">FishVR</div>
          <h1>FishVR • Official Loadout & Wiki</h1>
          <p>Optimizador físico, base de datos de especies, piscinas ocultas y catálogo de rarezas.</p>
        </div>
        
        <div class="island-header-stats">
          <div class="island-input-group island-input-money">
            <label>🪙 Monedas ($)</label>
            <input type="number" id="budget-input" min="0" step="500" value="0" />
          </div>
          <div class="island-input-group island-input-islands">
            <label>🏝️ Islas 100% (+15)</label>
            <input type="number" id="islands-input" min="0" max="6" value="0" />
          </div>
        </div>
      </header>

      <!-- BARRA DE NAVEGACIÓN -->
      <nav class="island-nav-bar">
        <button class="island-nav-btn active" data-target="sec-optimizer">🎣 Optimizador de Cañas</button>
        <button class="island-nav-btn" data-target="sec-fishdex">🐟 Base de Datos de Peces ({allFishData.length})</button>
        <button class="island-nav-btn" data-target="sec-rarities">✨ Rarezas, Mutaciones & Pools</button>
      </nav>

      <!-- SECCIÓN 1: OPTIMIZADOR DE CAÑAS -->
      <div id="sec-optimizer" class="island-view active">
        
        <section class="island-card island-filter-bar" style="margin-bottom: 20px;">
          <div>
            <h2>Estrategia de Pesca</h2>
            <p>Selecciona qué atributo priorizar en la caña y aparejos.</p>
          </div>
          <div class="island-tab-group" id="goal-container">
            <button class="island-tab active" data-stat="balance">⚖️ Balance Total</button>
            <button class="island-tab" data-stat="luck">🍀 Suerte</button>
            <button class="island-tab" data-stat="attractionRate">⚡ Velocidad</button>
            <button class="island-tab" data-stat="bigCatchRate">🐋 Peces Grandes</button>
            <button class="island-tab" data-stat="strength">💪 Fuerza</button>
            <button class="island-tab" data-stat="maxWeight">⚖️ Max Weight</button>
          </div>
        </section>

        <!-- Resultados -->
        <div class="island-grid-2" style="margin-bottom: 20px;">
          
          <div class="island-card island-card-featured">
            <div class="island-card-header">
              <span class="island-tag island-tag-cyan">Tu Build Óptima en Mochila</span>
              <span id="opt-total-stat" class="island-stat-value">Equilibrado</span>
            </div>
            
            <div class="island-item-preview">
              <div class="island-photo-frame island-frame-cyan" id="opt-rod-img-slot">🎣</div>
              <div>
                <h3 id="opt-title">Stick and String + Basic Line</h3>
                <span class="island-subtext">Build armónica sin cuellos de botella</span>
              </div>
            </div>
            
            <div class="island-data-sheet">
              <div class="island-row"><span>Caña Equipada:</span><strong id="opt-rod">Stick and String</strong></div>
              <div class="island-row"><span>Encantamiento:</span><strong id="opt-enchant" style="color: #4ef2bb;">Sin Encantamiento</strong></div>
              <div class="island-row"><span>Línea:</span><strong id="opt-line">Basic Line</strong></div>
              <div class="island-row"><span>Boya:</span><strong id="opt-bobber">Basic Bobber</strong></div>
            </div>
          </div>

          <div class="island-card island-card-upgrade">
            <div class="island-card-header">
              <span class="island-tag island-tag-mint">Próxima Gran Compra</span>
              <span id="next-gain" class="island-tag island-tag-sand">+0</span>
            </div>

            <div class="island-item-preview">
              <div class="island-photo-frame island-frame-mint" id="next-img-slot">⛵</div>
              <div>
                <h3 id="next-name">-</h3>
                <span id="next-type" class="island-subtext">-</span>
              </div>
            </div>

            <div class="island-data-sheet">
              <div class="island-row"><span>Puerto / Tienda:</span><strong id="next-loc" style="color: #ffd166;">-</strong></div>
              <div class="island-row"><span>Precio de Venta:</span><strong id="next-price">-</strong></div>
              <div class="island-row"><span>Estado de Bolsillo:</span><strong id="next-afford-status" style="color: #4ef2bb;">-</strong></div>
            </div>
          </div>

        </div>

        <!-- Mochila del Pescador -->
        <section class="island-card" style="margin-bottom: 20px;">
          <div class="island-inv-top">
            <div>
              <h2>Mochila del Pescador</h2>
              <p>Marca tus cañas y selecciona el encantamiento que le colocaste a cada una en el Altar.</p>
            </div>
            <div class="island-btn-group">
              <button id="btn-select-all" class="island-btn">Marcar todo</button>
              <button id="btn-select-basic" class="island-btn">Solo inicial</button>
            </div>
          </div>

          <div class="island-grid-inv">
            
            <div class="island-inv-column island-col-rods">
              <h4 style="color: #38efef;">Cañas y Encantamiento del Altar</h4>
              <div class="island-scrollbox-rods">
                {rodsData.map((r, i) => (
                  <div class="island-rod-entry">
                    <label class="island-entry-label">
                      <input type="checkbox" class="rod-inv-check" data-idx={i} checked={i === 0} />
                      <div class="island-entry-info">
                        <span class="island-name">{r.name}</span>
                        <span class="island-price">{r.price}</span>
                      </div>
                    </label>
                    
                    <div class="island-enchant-row">
                      <span>Altar:</span>
                      <select class="island-enchant-select" data-rod-idx={i}>
                        {enchantmentsData.map((e, eIdx) => (
                          <option value={eIdx}>
                            {e.name === "Sin Encantamiento" ? "Sin Encantamiento" : `[${e.rarity}] ${e.name}`}
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="island-inv-column">
              <h4 style="color: #4ef2bb;">Líneas (Lines)</h4>
              <div class="island-scrollbox">
                {linesData.map((l, i) => (
                  <label class="island-checkbox-entry">
                    <input type="checkbox" class="line-inv-check" data-idx={i} checked={i === 0} />
                    <div class="island-entry-info">
                      <span class="island-name">{l.name}</span>
                      <span class="island-price">{l.price}</span>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <div class="island-inv-column">
              <h4 style="color: #4ef2bb;">Boyas (Bobbers)</h4>
              <div class="island-scrollbox">
                {bobbersData.map((b, i) => (
                  <label class="island-checkbox-entry">
                    <input type="checkbox" class="bobber-inv-check" data-idx={i} checked={i === 0} />
                    <div class="island-entry-info">
                      <span class="island-name">{b.name}</span>
                      <span class="island-price">{b.price}</span>
                    </div>
                  </label>
                ))}
              </div>
            </div>

          </div>
        </section>

        <!-- Telemetría -->
        <section class="island-grid-stats" style="margin-bottom: 20px;">
          <div class="island-card island-stat-panel">
            <span style="color: #ffd166;">Suerte Total</span>
            <strong id="disp-luck" style="color: #ffd166;">-50</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #38efef;">Atracción</span>
            <strong id="disp-attraction" style="color: #38efef;">0%</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #a7f3d0;">Tiempo Ciclo</span>
            <strong id="disp-cycle" style="color: #ffffff;">19.0s</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #4ef2bb;">Capturas / Hr</span>
            <strong id="disp-catches" style="color: #4ef2bb;">189</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #67e8f9;">Max Weight</span>
            <strong id="disp-weight" style="color: #67e8f9;">5 kg</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #fde68a;">Big Catch</span>
            <strong id="disp-bigcatch" style="color: #fde68a;">-100</strong>
          </div>
        </section>

        <!-- Rarity Pool -->
        <section class="island-card">
          <div class="island-card-header" style="margin-bottom: 14px;">
            <div>
              <h2>Probabilidades de Captura (Rarity Pool)</h2>
              <p>Paleta oficial y distribución exponencial de Suerte del motor FishVR.</p>
            </div>
            <span id="disp-luck-mult" class="island-tag island-tag-cyan">Multiplicador: 0.50x</span>
          </div>
          <div id="rarity-container" class="island-grid-rarities">
            <!-- Render dinámico -->
          </div>
        </section>

      </div>

      <!-- SECCIÓN 2: BUSCADOR DE PECES COMPLETO -->
      <div id="sec-fishdex" class="island-view">
        <section class="island-card">
          <div class="island-inv-top">
            <div>
              <h2>Base de Datos de Peces por Isla</h2>
              <p>Consulta condiciones de captura, clima, horarios, tipos de agua y rangos de peso.</p>
            </div>
          </div>

          <!-- Barra de Filtros -->
          <div class="fish-search-bar">
            <input type="text" id="fish-search-input" placeholder="🔍 Buscar por nombre (ej. Minnow, Shark, Discus)..." class="fish-input" />
            <select id="fish-island-filter" class="fish-select">
              <option value="ALL">Todas las Islas</option>
              <option value="Coconut Bay">Coconut Bay</option>
              <option value="Crescent Isle">Crescent Isle</option>
              <option value="Volcanic Depths">Volcanic Depths</option>
              <option value="Luxian Dunes">Luxian Dunes</option>
              <option value="Tanglewood">Tanglewood</option>
              <option value="Twilight Realm">Twilight Realm</option>
            </select>
            <select id="fish-rarity-filter" class="fish-select">
              <option value="ALL">Todas las Rarezas</option>
              <option value="Abundant">Abundant</option>
              <option value="Common">Common</option>
              <option value="Curious">Curious</option>
              <option value="Elusive">Elusive</option>
              <option value="Fabled">Fabled</option>
              <option value="Mythic">Mythic</option>
