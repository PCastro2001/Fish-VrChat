  { name: "Wels Catfish", island: "Twilight Realm", category: "Local Fish", rarity: "Elusive", water: "Freshwater", weather: "Clear (1.5x)", time: "Any", minW: "7.2 kg", maxW: "73.3 kg" },
  { name: "Bichir", island: "Twilight Realm", category: "Local Fish", rarity: "Elusive", water: "Any", weather: "Any", time: "Any", minW: "1 kg", maxW: "3 kg" },
  { name: "Electric Catfish", island: "Twilight Realm", category: "Local Fish", rarity: "Elusive", water: "Any", weather: "Any", time: "Any", minW: "6.2 kg", maxW: "50.9 kg" },
  { name: "Nile Perch", island: "Twilight Realm", category: "Local Fish", rarity: "Elusive", water: "Any", weather: "Any", time: "Any", minW: "56.2 kg", maxW: "385.2 kg" },
  { name: "Tiger Shovelnose Catfish", island: "Twilight Realm", category: "Local Fish", rarity: "Elusive", water: "Any", weather: "Any", time: "Any", minW: "4.3 kg", maxW: "6.0 kg" },
  { name: "Elephant Fish", island: "Twilight Realm", category: "Local Fish", rarity: "Fabled", water: "Any", weather: "Any", time: "Any", minW: "0.5 kg", maxW: "1.5 kg" },
  { name: "Mirage Fish", island: "Twilight Realm", category: "Local Fish", rarity: "Mythic", water: "Any", weather: "Any", time: "Any", minW: "215.8 kg", maxW: "299.5 kg" },
  { name: "Sarcophagus", island: "Twilight Realm", category: "Local Fish", rarity: "Exotic", water: "Any", weather: "Any", time: "Any", minW: "3,476.4 kg", maxW: "6,978.1 kg" }
];

const occultPoolsData = [
  { name: "School of Fish", effect: "Aumenta drásticamente la probabilidad de pescar ese pez específico", multiplier: "Específico", type: "Cardumen" },
  { name: "Strange Whirlpool", effect: "1.5x probabilidad de todas las mutaciones y 2x multiplicador de Suerte", multiplier: "1.5x Mut / 2x Luck", type: "Vórtice General" },
  { name: "Sandy Updraft", effect: "1.9x probabilidad de mutación Sandy fish", multiplier: "1.9x Sandy", type: "Dunas / Viento" },
  { name: "Savanna Rift", effect: "1.9x probabilidad de modificadores Tiger & Zebra", multiplier: "1.9x Tiger/Zebra", type: "Falla Terrestre" },
  { name: "Shadow Chasm", effect: "1.9x probabilidad de mutación Shadow fish", multiplier: "1.9x Shadow", type: "Abismo Sombrío" },
  { name: "Sparkling Pool", effect: "1.9x probabilidad de mutación Shiny fish", multiplier: "1.9x Shiny", type: "Piscina Brillante" },
  { name: "Ionized Fissure", effect: "1.9x probabilidad de mutación Radioactive fish", multiplier: "1.9x Radioactive", type: "Fisura Ionizada" },
  { name: "Celestial Chasm", effect: "1.9x probabilidad de mutación Galaxy fish", multiplier: "1.9x Galaxy", type: "Abismo Celestial" },
  { name: "Midas Rift", effect: "1.9x probabilidad de mutación Gold fish", multiplier: "1.9x Gold", type: "Falla Dorada" },
  { name: "Occult Pool", effect: "1.9x probabilidad de mutación Cursed fish", multiplier: "1.9x Cursed", type: "Piscina Oculta" }
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FishVR - Official Loadout & Wiki</title>
  </head>
  <body>
    <div class="island-bg-glow"></div>

    <div class="island-container">
      
      <!-- TOP HEADER (FISHVR) -->
      <header class="island-card island-header">
        <div>
          <div class="island-badge">FishVR</div>
          <h1>FishVR • Official Loadout & Wiki</h1>
          <p>Optimizador físico, análisis de balance, base de datos y catálogo de mutaciones.</p>
        </div>
        
        <div class="island-header-stats">
          <div class="island-input-group island-input-money">
            <label>🪙 Monedas ($)</label>
            <input type="number" id="budget-input" min="0" step="500" value="0" />
          </div>
          <div class="island-input-group island-input-islands">
            <label>🏝️ Islas 100% (+15)</label>
            <input type="number" id="islands-input" min="0" max="6" value="0" />
          </div>
        </div>
      </header>

      <!-- BARRA DE NAVEGACIÓN -->
      <nav class="island-nav-bar">
        <button class="island-nav-btn active" data-target="sec-optimizer">🎣 Optimizador de Cañas</button>
        <button class="island-nav-btn" data-target="sec-fishdex">🐟 Base de Datos de Peces ({allFishData.length})</button>
        <button class="island-nav-btn" data-target="sec-rarities">✨ Rarezas, Mutaciones & Pools</button>
        <button class="island-nav-btn" data-target="sec-shops">🏪 Guía de Tiendas & Mejoras</button>
      </nav>

      <!-- SECCIÓN 1: OPTIMIZADOR DE CAÑAS -->
      <div id="sec-optimizer" class="island-view active">
        
        <section class="island-card island-filter-bar" style="margin-bottom: 20px;">
          <div>
            <h2>Estrategia de Pesca</h2>
            <p>Selecciona qué atributo priorizar en la caña y aparejos.</p>
          </div>
          <div class="island-tab-group" id="goal-container">
            <button class="island-tab active" data-stat="balance">⚖️ Balance Total</button>
            <button class="island-tab" data-stat="luck">🍀 Suerte</button>
            <button class="island-tab" data-stat="attractionRate">⚡ Velocidad</button>
            <button class="island-tab" data-stat="bigCatchRate">🐋 Peces Grandes</button>
            <button class="island-tab" data-stat="strength">💪 Fuerza / Minijuego</button>
            <button class="island-tab" data-stat="maxWeight">⚖️ Max Weight</button>
          </div>
        </section>

        <!-- RESULTADOS: TU BUILD + 2 VÍAS DE PROGRESIÓN (ORO VS RELIQUIAS) -->
		<div class="island-grid-3" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; margin-bottom: 20px;">
		
		<!-- 1. TU MEJOR BUILD ACTUAL -->
		<div class="island-card island-card-featured">
			<div class="island-card-header">
			<span class="island-tag island-tag-cyan">Build Activa en Mochila</span>
			<span id="opt-total-stat" class="island-stat-value">Equilibrado</span>
			</div>
			
			<div class="island-item-preview">
			<div class="island-photo-frame island-frame-cyan" id="opt-rod-img-slot">🎣</div>
			<div>
				<h3 id="opt-title">Stick and String + Basic Line</h3>
				<span class="island-subtext">Configuración óptima actual</span>
			</div>
			</div>
			
			<div class="island-data-sheet">
			<div class="island-row"><span>Caña Equipada:</span><strong id="opt-rod">Stick and String</strong></div>
			<div class="island-row"><span>Encantamiento:</span><strong id="opt-enchant" style="color: #4ef2bb;">Sin Encantamiento</strong></div>
			<div class="island-row"><span>Línea:</span><strong id="opt-line">Basic Line</strong></div>
			<div class="island-row"><span>Boya:</span><strong id="opt-bobber">Basic Bobber</strong></div>
			</div>
		</div>

		<!-- 2. OPCIÓN A: RUTA DE TIENDA (SI TIENES DINERO) -->
		<div class="island-card island-card-upgrade">
			<div class="island-card-header">
			<span class="island-tag island-tag-sand">Ruta 1: Tienda ($)</span>
			<span id="next-gain" class="island-tag island-tag-mint">+0</span>
			</div>

			<div class="island-item-preview">
			<div class="island-photo-frame island-frame-sand" style="border: 1px solid #ffd166;" id="next-img-slot">🪙</div>
			<div>
				<h3 id="next-name">-</h3>
				<span id="next-type" class="island-subtext">Comprar en el Puerto</span>
			</div>
			</div>

			<div class="island-data-sheet">
			<div class="island-row"><span>Ubicación:</span><strong id="next-loc" style="color: #ffd166;">-</strong></div>
			<div class="island-row"><span>Precio de Venta:</span><strong id="next-price">-</strong></div>
			<div class="island-row"><span>Bolsillo:</span><strong id="next-afford-status" style="color: #4ef2bb;">-</strong></div>
			</div>
		</div>

		<!-- 3. OPCIÓN B: RUTA DE ALTAR (SI TIENES RELIQUIAS) -->
		<div class="island-card" style="background: linear-gradient(145deg, #181329, #0c2331); border-color: #554496;">
			<div class="island-card-header">
			<span class="island-tag" style="background-color: rgba(196,195,234,0.15); color: #c4c3ea; border: 1px solid #c4c3ea;">Ruta 2: Altar (Reliquias)</span>
			<span id="altar-target-rarity" class="island-tag" style="background-color: rgba(78,242,187,0.15); color: #4ef2bb; border: 1px solid #4ef2bb;">Recomendado</span>
			</div>

			<div class="island-item-preview">
			<div class="island-photo-frame" style="border: 1px solid #c4c3ea;">🔮</div>
			<div>
				<h3 id="altar-ench-name" style="color: #ffffff;">God's Own Luck</h3>
				<span id="altar-ench-sub" class="island-subtext">Buscar en Altar de Crescent Isle</span>
			</div>
			</div>

			<div class="island-data-sheet">
			<div class="island-row"><span>Para tu caña:</span><strong id="altar-target-rod" style="color: #38efef;">-</strong></div>
			<div class="island-row"><span>Efecto:</span><strong id="altar-ench-effect" style="color: #ffd166;">-</strong></div>
			<div class="island-row"><span>Costo:</span><strong style="color: #c4c3ea;">Tirar Reliquias al Altar</strong></div>
			</div>
		</div>

		</div>

        <!-- Mochila del Pescador -->
        <section class="island-card" style="margin-bottom: 20px;">
          <div class="island-inv-top">
            <div>
              <h2>Mochila del Pescador</h2>
              <p>Marca tus cañas y selecciona el encantamiento que le colocaste a cada una en el Altar.</p>
            </div>
            <div class="island-btn-group">
              <button id="btn-select-all" class="island-btn">Marcar todo</button>
              <button id="btn-select-basic" class="island-btn">Solo inicial</button>
            </div>
          </div>

          <div class="island-grid-inv">
            
            <div class="island-inv-column island-col-rods">
              <h4 style="color: #38efef;">Cañas y Encantamiento del Altar</h4>
              <div class="island-scrollbox-rods">
                {rodsData.map((r, i) => (
                  <div class="island-rod-entry">
                    <label class="island-entry-label">
                      <input type="checkbox" class="rod-inv-check" data-idx={i} checked={i === 0} />
                      <div class="island-entry-info">
                        <span class="island-name">{r.name}</span>
                        <span class="island-price">{r.price}</span>
                      </div>
                    </label>
                    
                    <div class="island-enchant-row">
                      <span>Altar:</span>
                      <select class="island-enchant-select" data-rod-idx={i}>
                        {enchantmentsData.map((e, eIdx) => (
                          <option value={eIdx}>
                            {e.name === "Sin Encantamiento" ? "Sin Encantamiento" : `[${e.rarity}] ${e.name}`}
                          </option>
                        ))}
                      </select>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="island-inv-column">
              <h4 style="color: #4ef2bb;">Líneas (Lines)</h4>
              <div class="island-scrollbox">
                {linesData.map((l, i) => (
                  <label class="island-checkbox-entry">
                    <input type="checkbox" class="line-inv-check" data-idx={i} checked={i === 0} />
                    <div class="island-entry-info">
                      <span class="island-name">{l.name}</span>
                      <span class="island-price">{l.price}</span>
                    </div>
                  </label>
                ))}
              </div>
            </div>

            <div class="island-inv-column">
              <h4 style="color: #4ef2bb;">Boyas (Bobbers)</h4>
              <div class="island-scrollbox">
                {bobbersData.map((b, i) => (
                  <label class="island-checkbox-entry">
                    <input type="checkbox" class="bobber-inv-check" data-idx={i} checked={i === 0} />
                    <div class="island-entry-info">
                      <span class="island-name">{b.name}</span>
                      <span class="island-price">{b.price}</span>
                    </div>
                  </label>
                ))}
              </div>
            </div>

          </div>
        </section>

        <!-- Telemetría Física -->
        <section class="island-grid-stats" style="margin-bottom: 20px;">
          <div class="island-card island-stat-panel">
            <span style="color: #ffd166;">Suerte Total</span>
            <strong id="disp-luck" style="color: #ffd166;">-50</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #38efef;">Atracción</span>
            <strong id="disp-attraction" style="color: #38efef;">0%</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #a7f3d0;">Minijuego (Str+Exp)</span>
            <strong id="disp-minigame" style="color: #ffffff;">0</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #4ef2bb;">Capturas / Hr</span>
            <strong id="disp-catches" style="color: #4ef2bb;">189</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #67e8f9;">Max Weight</span>
            <strong id="disp-weight" style="color: #67e8f9;">5 kg</strong>
          </div>
          <div class="island-card island-stat-panel">
            <span style="color: #fde68a;">Big Catch</span>
            <strong id="disp-bigcatch" style="color: #fde68a;">-100</strong>
          </div>
        </section>

        <!-- Rarity Pool -->
        <section class="island-card">
          <div class="island-card-header" style="margin-bottom: 14px;">
            <div>
              <h2>Probabilidades de Captura (Rarity Pool)</h2>
              <p>Paleta oficial y distribución exponencial de Suerte del motor FishVR.</p>
            </div>
            <span id="disp-luck-mult" class="island-tag island-tag-cyan">Multiplicador: 0.50x</span>
          </div>
          <div id="rarity-container" class="island-grid-rarities">
            <!-- Render dinámico -->
          </div>
        </section>

      </div>

      <!-- SECCIÓN 2: BUSCADOR DE PECES -->
      <div id="sec-fishdex" class="island-view">
        <section class="island-card">
          <div class="island-inv-top">
            <div>
              <h2>Base de Datos de Peces por Isla</h2>
              <p>Consulta condiciones de captura, clima, horarios, tipos de agua y rangos de peso.</p>
            </div>
          </div>

          <div class="fish-search-bar">
            <input type="text" id="fish-search-input" placeholder="🔍 Buscar por nombre (ej. Minnow, Shark, Discus)..." class="fish-input" />
            <select id="fish-island-filter" class="fish-select">
              <option value="ALL">Todas las Islas</option>
              <option value="Coconut Bay">Coconut Bay</option>
              <option value="Crescent Isle">Crescent Isle</option>
              <option value="Volcanic Depths">Volcanic Depths</option>
              <option value="Luxian Dunes">Luxian Dunes</option>
              <option value="Tanglewood">Tanglewood</option>
              <option value="Twilight Realm">Twilight Realm</option>
            </select>
            <select id="fish-rarity-filter" class="fish-select">
              <option value="ALL">Todas las Rarezas</option>
              <option value="Abundant">Abundant</option>
              <option value="Common">Common</option>
              <option value="Curious">Curious</option>
              <option value="Elusive">Elusive</option>
              <option value="Fabled">Fabled</option>
              <option value="Mythic">Mythic</option>
              <option value="Exotic">Exotic</option>
            </select>
            <select id="fish-water-filter" class="fish-select">
              <option value="ALL">Todo Tipo de Agua</option>
              <option value="Freshwater">Freshwater</option>
              <option value="Saltwater">Saltwater</option>
              <option value="Lava">Lava</option>
              <option value="Swampwater">Swampwater</option>
            </select>
          </div>

          <div class="fish-table-wrapper">
            <table class="fish-table">
              <thead>
                <tr>
                  <th>Especie</th>
                  <th>Rareza</th>
                  <th>Isla / Ubicación</th>
                  <th>Tipo de Agua</th>
                  <th>Clima Requerido</th>
                  <th>Horario</th>
                  <th>Peso Mínimo</th>
                  <th>Peso Máximo</th>
                </tr>
              </thead>
              <tbody id="fish-table-body">
                {allFishData.map(f => (
                  <tr class="fish-row" data-name={f.name.toLowerCase()} data-island={f.island} data-rarity={f.rarity} data-water={f.water}>
                    <td class="font-bold text-white">{f.name}</td>
                    <td><span class={`rarity-badge rarity-${f.rarity.toLowerCase().replace(/\s+/g, '-')}`}>{f.rarity}</span></td>
                    <td style="color: #38efef;">{f.island} <span style="font-size: 10px; color: #93c5b5; display:block;">({f.category})</span></td>
                    <td style="color: #4ef2bb;">{f.water}</td>
                    <td style={f.weather.includes('1.5x') ? "color: #ffd166; font-weight: bold;" : "color: #93c5b5;"}>{f.weather}</td>
                    <td>{f.time}</td>
                    <td>{f.minW}</td>
                    <td class="font-bold" style="color: #ffffff;">{f.maxW}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      </div>

      <!-- SECCIÓN 3: RAREZAS, MUTACIONES & POOLS -->
      <div id="sec-rarities" class="island-view">
        
        <!-- PISCINAS OCULTAS -->
        <section class="island-card" style="margin-bottom: 20px;">
          <div class="island-card-header">
            <div>
              <h2>🌌 Piscinas Ocultas y Vórtices (Occult Pools)</h2>
              <p>Multiplicadores de aparición y condiciones especiales en aguas del archipiélago.</p>
            </div>
            <span class="island-tag island-tag-cyan">10 Eventos Documentados</span>
          </div>

          <div class="occult-pools-grid">
            {occultPoolsData.map(pool => (
              <div class="occult-pool-card">
                <div class="flex justify-between items-center mb-1">
                  <strong class="text-white text-sm">{pool.name}</strong>
                  <span class="occult-mult-badge">{pool.multiplier}</span>
                </div>
                <span class="occult-type-badge">{pool.type}</span>
                <p class="text-xs text-slate-300 mt-2">{pool.effect}</p>
              </div>
            ))}
          </div>
        </section>

        <!-- TABLA DE MUTACIONES Y PURIFICACIÓN -->
        <section class="island-card" style="margin-bottom: 20px;">
          <div class="island-card-header" style="margin-bottom: 12px;">
            <div>
              <h2>🧬 Fish Mutations & Value Modifiers</h2>
              <p>Multiplicadores de venta oficiales por mutación y mecánicas de alteración.</p>
            </div>
            <span class="island-tag island-tag-mint">Valores Oficiales</span>
          </div>

          <div class="purity-alert-box" style="background: linear-gradient(135deg, rgba(244,63,94,0.15), rgba(78,242,187,0.15)); border: 1px solid #38efef; border-radius: 12px; padding: 12px 16px; margin-bottom: 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
            <div>
              <strong style="color: #4ef2bb; font-size: 13px; display: block;">⛪ Mecánica de Purificación (Tanglewood Church)</strong>
              <span style="font-size: 11px; color: #d1fae5;">Puedes llevar cualquier pez con mutación <strong style="color: #f43f5e;">Cursed (1.1x)</strong> a la Iglesia de Tanglewood para purificarlo y transformarlo en <strong style="color: #ffffff;">Blessed (3x)</strong>.</span>
            </div>
            <span style="font-size: 16px; font-weight: 900; color: #ffd166; white-space: nowrap;">1.1x ➔ 3.0x</span>
          </div>

          <div class="fish-table-wrapper">
            <table class="fish-table">
              <thead>
                <tr>
                  <th>Mutation / Modifiers</th>
                  <th style="text-align: right;">Modifier Multiplier</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td style="color: #f43f5e; font-weight: bold;">🔱 Cursed</td>
                  <td style="text-align: right; font-weight: bold; color: #ffd166;">1.1x</td>
                </tr>
                <tr>
                  <td style="color: #ffe082; font-weight: bold;">🏰 Sandy</td>
                  <td style="text-align: right; font-weight: bold; color: #ffd166;">1.2x</td>
                </tr>
                <tr>
                  <td style="color: #cbd5e1;">🪨 Stone, 🧲 Zebra</td>
                  <td style="text-align: right; font-weight: bold; color: #ffd166;">1.3x</td>
                </tr>
                <tr>
                  <td>
                    <span style="color: #60a5fa;">⛔ Negative</span>, 
                    <span style="color: #ffffff;">🐰 Albino</span>, 
                    <span style="color: #94a3b8;">👤 Ghastly</span>, 
                    <span style="color: #c084fc;">✖️ Glitched</span>
                  </td>
                  <td style="text-align: right; font-weight: bold; color: #ffd166;">1.5x</td>
                </tr>
                <tr>
                  <td style="color: #fb923c; font-weight: bold;">🐾 Tiger</td>
                  <td style="text-align: right; font-weight: bold; color: #ffd166;">1.6x</td>
                </tr>
                <tr>
                  <td style="color: #4ade80; font-weight: bold;">🌾 Camo</td>
                  <td style="text-align: right; font-weight: bold; color: #ffd166;">1.8x</td>
                </tr>
                <tr>
                  <td>
                    <span style="color: #c084fc;">🔮 Void</span>, 
                    <span style="color: #64748b;">👁️ Shadow</span>, 
                    <span style="color: #38efef; font-weight: bold;">✨ Shiny</span>, 
                    <span style="color: #93c5fd;">❄️ Frozen</span>
                  </td>
                  <td style="text-align: right; font-weight: 900; color: #38efef; font-size: 15px;">2x</td>
                </tr>
                <tr>
                  <td>
                    <span style="color: #f8fafc; font-weight: bold;">👼 Blessed</span>, 
                    <span style="color: #facc15; font-weight: bold;">👑 Golden</span>, 
