<div class="bg-neutral-900/90 border border-white/10 p-5 rounded-2xl">
  <h4 class="text-base font-bold text-white mb-3">⚡ Rendimiento Físico de tu Build</h4>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4 text-center">
    
    <div class="bg-neutral-950/70 p-3 rounded-xl border border-white/5">
      <span class="text-[10px] text-slate-400 uppercase font-bold block">Tiempo de Picada</span>
      <span id="bite-time-val" class="text-xl font-black text-cyan-400">14.0s</span>
      <span id="bite-time-sub" class="text-[10px] text-slate-500 block mt-0.5">Base normal</span>
    </div>

    <div class="bg-neutral-950/70 p-3 rounded-xl border border-white/5">
      <span class="text-[10px] text-slate-400 uppercase font-bold block">Área de Barra (Minijuego)</span>
      <span id="expertise-val" class="text-xl font-black text-sky-400">+0%</span>
      <span class="text-[10px] text-slate-500 block mt-0.5">Por Expertise</span>
    </div>

    <div class="bg-neutral-950/70 p-3 rounded-xl border border-white/5">
      <span class="text-[10px] text-slate-400 uppercase font-bold block">Estabilidad (Fuerza)</span>
      <span id="strength-val" class="text-xl font-black text-rose-400">+0 pts</span>
      <span class="text-[10px] text-slate-500 block mt-0.5">Menos sacudidas</span>
    </div>

    <div class="bg-neutral-950/70 p-3 rounded-xl border border-white/5">
      <span class="text-[10px] text-slate-400 uppercase font-bold block">Sesgo de Peso (Big Catch)</span>
      <span id="bigcatch-val" class="text-xl font-black text-orange-400">+0</span>
      <span class="text-[10px] text-slate-500 block mt-0.5">Peces más pesados</span>
    </div>

  </div>
</div>