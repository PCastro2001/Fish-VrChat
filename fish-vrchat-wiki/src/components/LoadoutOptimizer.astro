---
import { rodsData, linesData, bobbersData } from '../data/gear';
---

<div class="space-y-8">
  <!-- Selector de Objetivo / Meta -->
  <div class="bg-neutral-900/90 border border-white/10 p-4 rounded-xl flex flex-col md:flex-row items-center justify-between gap-4">
    <div>
      <h3 class="text-lg font-bold text-white">Objetivo de Pesca</h3>
      <p class="text-xs text-slate-400">¿Qué estadística quieres maximizar?</p>
    </div>
    <div class="flex flex-wrap gap-2" id="goal-selectors">
      <button class="goal-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-400 text-neutral-950" data-stat="luck">🍀 Suerte (Luck)</button>
      <button class="goal-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-neutral-800 text-slate-300 hover:text-white" data-stat="attractionRate">⚡ Velocidad (Attraction)</button>
      <button class="goal-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-neutral-800 text-slate-300 hover:text-white" data-stat="bigCatchRate">🐋 Peces Grandes (Big Catch)</button>
      <button class="goal-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-neutral-800 text-slate-300 hover:text-white" data-stat="strength">💪 Fuerza (Strength)</button>
    </div>
  </div>

  <!-- Panel de Mejor Build Calculada -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    
    <!-- Build Óptima Actual -->
    <div class="bg-gradient-to-br from-cyan-950/40 to-neutral-900/90 border border-cyan-500/40 p-5 rounded-2xl relative overflow-hidden">
      <span class="text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 rounded-full">Tu Mejor Build Actual</span>
      <h4 class="text-2xl font-black text-white mt-2 mb-4" id="best-build-title">Calculando...</h4>
      
      <div class="space-y-2 text-sm">
        <div class="flex justify-between border-b border-white/5 pb-1">
          <span class="text-slate-400">Caña:</span>
          <span class="font-bold text-slate-200" id="res-rod">-</span>
        </div>
        <div class="flex justify-between border-b border-white/5 pb-1">
          <span class="text-slate-400">Línea:</span>
          <span class="font-bold text-slate-200" id="res-line">-</span>
        </div>
        <div class="flex justify-between border-b border-white/5 pb-1">
          <span class="text-slate-400">Boya:</span>
          <span class="font-bold text-slate-200" id="res-bobber">-</span>
        </div>
      </div>

      <div class="mt-4 pt-3 border-t border-white/10 flex justify-between items-center">
        <span class="text-xs text-slate-400">Estadística Total:</span>
        <span class="text-xl font-black text-cyan-400" id="total-stat-val">+0</span>
      </div>
    </div>

    <!-- Siguiente Gran Mejora -->
    <div class="bg-neutral-900/90 border border-purple-500/30 p-5 rounded-2xl relative">
      <span class="text-[10px] font-bold tracking-wider uppercase px-2 py-0.5 bg-purple-500/20 text-purple-300 border border-purple-500/30 rounded-full">Próxima Mejor Mejora</span>
      <h4 class="text-xl font-bold text-white mt-2" id="next-upgrade-name">-</h4>
      <p class="text-xs text-slate-400 mt-1 mb-3" id="next-upgrade-type">-</p>
      
      <div class="bg-neutral-950/60 p-3 rounded-lg border border-white/5 text-xs space-y-1">
        <div class="flex justify-between"><span class="text-slate-400">Dónde conseguir:</span> <span class="text-amber-300 font-semibold" id="next-upgrade-loc">-</span></div>
        <div class="flex justify-between"><span class="text-slate-400">Precio / Requisito:</span> <span class="text-slate-200 font-semibold" id="next-upgrade-price">-</span></div>
        <div class="flex justify-between"><span class="text-slate-400">Ganancia neta:</span> <span class="text-emerald-400 font-bold" id="next-upgrade-gain">+0</span></div>
      </div>
    </div>

  </div>

  <!-- Selección de Inventario del Jugador -->
  <div class="bg-neutral-900/60 border border-white/10 p-5 rounded-2xl">
    <div class="flex justify-between items-center mb-4">
      <h4 class="text-lg font-bold text-white">Marca tu Inventario</h4>
      <button id="select-all-btn" class="text-xs text-cyan-400 hover:underline">Seleccionar todo básicos</button>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Inventario Cañas -->
      <div class="space-y-2">
        <h5 class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Cañas (Rods)</h5>
        <div class="max-h-64 overflow-y-auto space-y-1.5 pr-2">
          {rodsData.map((rod, idx) => (
            <label class="flex items-center gap-2 p-2 rounded bg-neutral-950/50 hover:bg-neutral-800/50 border border-white/5 cursor-pointer text-xs">
              <input type="checkbox" class="gear-check rod-check rounded accent-cyan-400" data-idx={idx} checked={idx === 0} />
              <span class="text-slate-200 font-medium">{rod.name}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Inventario Líneas -->
      <div class="space-y-2">
        <h5 class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Líneas (Lines)</h5>
        <div class="max-h-64 overflow-y-auto space-y-1.5 pr-2">
          {linesData.map((line, idx) => (
            <label class="flex items-center gap-2 p-2 rounded bg-neutral-950/50 hover:bg-neutral-800/50 border border-white/5 cursor-pointer text-xs">
              <input type="checkbox" class="gear-check line-check rounded accent-cyan-400" data-idx={idx} checked={idx === 0} />
              <span class="text-slate-200 font-medium">{line.name}</span>
            </label>
          ))}
        </div>
      </div>

      <!-- Inventario Boyas -->
      <div class="space-y-2">
        <h5 class="text-xs font-bold text-cyan-400 uppercase tracking-wider">Boyas (Bobbers)</h5>
        <div class="max-h-64 overflow-y-auto space-y-1.5 pr-2">
          {bobbersData.map((bobber, idx) => (
            <label class="flex items-center gap-2 p-2 rounded bg-neutral-950/50 hover:bg-neutral-800/50 border border-white/5 cursor-pointer text-xs">
              <input type="checkbox" class="gear-check bobber-check rounded accent-cyan-400" data-idx={idx} checked={idx === 0} />
              <span class="text-slate-200 font-medium">{bobber.name}</span>
            </label>
          ))}
        </div>
      </div>

    </div>
  </div>
</div>

<script>
  import { rodsData, linesData, bobbersData } from '../data/gear';

  let currentStat = 'luck';

  function parseStat(valStr: string | undefined): number {
    if (!valStr || valStr === '-') return 0;
    const clean = valStr.replace('%', '').replace('+', '').trim();
    return parseFloat(clean) || 0;
  }

  function calculateOptimal() {
    const selectedRods = Array.from(document.querySelectorAll<HTMLInputElement>('.rod-check:checked'))
      .map(cb => rodsData[parseInt(cb.dataset.idx!)]);
    const selectedLines = Array.from(document.querySelectorAll<HTMLInputElement>('.line-check:checked'))
      .map(cb => linesData[parseInt(cb.dataset.idx!)]);
    const selectedBobbers = Array.from(document.querySelectorAll<HTMLInputElement>('.bobber-check:checked'))
      .map(cb => bobbersData[parseInt(cb.dataset.idx!)]);

    // Calcular el mejor de cada uno según la estadística actual
    const bestRod = selectedRods.sort((a, b) => parseStat(b[currentStat as keyof typeof b]) - parseStat(a[currentStat as keyof typeof a]))[0] || rodsData[0];
    const bestLine = selectedLines.sort((a, b) => parseStat(b[currentStat as keyof typeof b]) - parseStat(a[currentStat as keyof typeof a]))[0] || linesData[0];
    const bestBobber = selectedBobbers.sort((a, b) => parseStat(b[currentStat as keyof typeof b]) - parseStat(a[currentStat as keyof typeof a]))[0] || bobbersData[0];

    const currentTotal = parseStat(bestRod[currentStat as keyof typeof bestRod]) +
                         parseStat(bestLine[currentStat as keyof typeof bestLine]) +
                         parseStat(bestBobber[currentStat as keyof typeof bestBobber]);

    // Actualizar UI de la mejor build actual
    document.getElementById('best-build-title')!.textContent = `${bestRod.name} Combo`;
    document.getElementById('res-rod')!.textContent = bestRod.name;
    document.getElementById('res-line')!.textContent = bestLine.name;
    document.getElementById('res-bobber')!.textContent = bestBobber.name;
    
    const isPercent = ['attractionRate'].includes(currentStat);
    document.getElementById('total-stat-val')!.textContent = `+${currentTotal}${isPercent ? '%' : ''}`;

    // Buscar la siguiente mejor mejora en el juego que NO tenga marcada
    const unownedRods = rodsData.filter(r => !selectedRods.includes(r));
    const unownedLines = linesData.filter(l => !selectedLines.includes(l));
    const unownedBobbers = bobbersData.filter(b => !selectedBobbers.includes(b));

    const potentialUpgrades = [
      ...unownedRods.map(i => ({ ...i, type: 'Caña (Rod)', gain: parseStat(i[currentStat as keyof typeof i]) - parseStat(bestRod[currentStat as keyof typeof bestRod]) })),
      ...unownedLines.map(i => ({ ...i, type: 'Línea (Line)', gain: parseStat(i[currentStat as keyof typeof i]) - parseStat(bestLine[currentStat as keyof typeof bestLine]) })),
      ...unownedBobbers.map(i => ({ ...i, type: 'Boya (Bobber)', gain: parseStat(i[currentStat as keyof typeof i]) - parseStat(bestBobber[currentStat as keyof typeof bestBobber]) }))
    ].filter(u => u.gain > 0).sort((a, b) => b.gain - a.gain);

    const nextUp = potentialUpgrades[0];
    if (nextUp) {
      document.getElementById('next-upgrade-name')!.textContent = nextUp.name;
      document.getElementById('next-upgrade-type')!.textContent = nextUp.type;
      document.getElementById('next-upgrade-loc')!.textContent = nextUp.location;
      document.getElementById('next-upgrade-price')!.textContent = nextUp.price;
      document.getElementById('next-upgrade-gain')!.textContent = `+${nextUp.gain}${isPercent ? '%' : ''} ${currentStat}`;
    } else {
      document.getElementById('next-upgrade-name')!.textContent = '¡Tienes la build máxima!';
      document.getElementById('next-upgrade-type')!.textContent = 'No hay mejores objetos en el juego para esta estadística.';
      document.getElementById('next-upgrade-loc')!.textContent = '-';
      document.getElementById('next-upgrade-price')!.textContent = '-';
      document.getElementById('next-upgrade-gain')!.textContent = '+0';
    }
  }

  // Event Listeners
  document.querySelectorAll('.gear-check').forEach(cb => cb.addEventListener('change', calculateOptimal));

  document.querySelectorAll('.goal-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      document.querySelectorAll('.goal-btn').forEach(b => {
        b.className = 'goal-btn px-3 py-1.5 rounded-lg text-xs font-semibold bg-neutral-800 text-slate-300 hover:text-white';
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.className = 'goal-btn active px-3 py-1.5 rounded-lg text-xs font-semibold bg-amber-400 text-neutral-950';
      currentStat = target.dataset.stat!;
      calculateOptimal();
    });
  });

  // Cálculo inicial
  calculateOptimal();
</script>