---
import { rodsData, linesData, bobbersData } from '../data/gear';
import { enchantmentsData } from '../data/enchantments';
---

<div class="space-y-8 max-w-7xl mx-auto p-4 md:p-6 text-slate-100 font-sans">
  
  <!-- 1. ENCABEZADO Y TÍTULOS DE ISLAS -->
  <div class="bg-neutral-900/90 border border-white/10 p-5 rounded-2xl flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <h2 class="text-2xl font-black text-white tracking-wide">Fishing Loadout & Math Engine</h2>
      <p class="text-xs text-slate-400 mt-1">Configura tu inventario para calcular tus estadísticas reales, tiempos de ciclo y probabilidades de rareza.</p>
    </div>

    <!-- Títulos de Islas Completadas (+15 Luck c/u) -->
    <div class="bg-neutral-950 border border-amber-500/30 p-3 rounded-xl flex items-center gap-3">
      <div>
        <span class="text-[10px] uppercase font-bold text-amber-300 block">Islas al 100% (+15 Suerte c/u)</span>
        <span class="text-xs text-slate-400">Títulos de maestría completados</span>
      </div>
      <input 
        type="number" 
        id="islands-completed" 
        min="0" 
        max="6" 
        value="0" 
        class="w-14 bg-neutral-900 border border-neutral-700 text-center text-amber-300 font-bold rounded-lg p-1.5 text-sm outline-none focus:border-amber-400"
      />
    </div>
  </div>

  <!-- 2. SELECTOR DE INVENTARIO (EQUIPO ACTIVO) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    
    <!-- Selector Caña -->
    <div class="bg-neutral-900/80 border border-white/10 p-4 rounded-xl">
      <label class="text-xs font-bold text-cyan-400 uppercase tracking-wider block mb-2">Caña (Rod)</label>
      <select id="select-rod" class="w-full bg-neutral-950 border border-neutral-700 text-slate-200 text-xs rounded-lg p-2.5 outline-none focus:border-cyan-400">
        {rodsData.map((rod, idx) => (
          <option value={idx}>{rod.name} ({rod.price})</option>
        ))}
      </select>
    </div>

    <!-- Selector Línea -->
    <div class="bg-neutral-900/80 border border-white/10 p-4 rounded-xl">
      <label class="text-xs font-bold text-cyan-400 uppercase tracking-wider block mb-2">Línea (Line)</label>
      <select id="select-line" class="w-full bg-neutral-950 border border-neutral-700 text-slate-200 text-xs rounded-lg p-2.5 outline-none focus:border-cyan-400">
        {linesData.map((line, idx) => (
          <option value={idx}>{line.name} ({line.price})</option>
        ))}
      </select>
    </div>

    <!-- Selector Boya -->
    <div class="bg-neutral-900/80 border border-white/10 p-4 rounded-xl">
      <label class="text-xs font-bold text-cyan-400 uppercase tracking-wider block mb-2">Boya (Bobber)</label>
      <select id="select-bobber" class="w-full bg-neutral-950 border border-neutral-700 text-slate-200 text-xs rounded-lg p-2.5 outline-none focus:border-cyan-400">
        {bobbersData.map((bobber, idx) => (
          <option value={idx}>{bobber.name} ({bobber.price})</option>
        ))}
      </select>
    </div>

    <!-- Selector Encantamiento -->
    <div class="bg-neutral-900/80 border border-purple-500/30 p-4 rounded-xl">
      <label class="text-xs font-bold text-purple-400 uppercase tracking-wider block mb-2">Encantamiento (Altar)</label>
      <select id="select-enchant" class="w-full bg-neutral-950 border border-neutral-700 text-slate-200 text-xs rounded-lg p-2.5 outline-none focus:border-purple-400">
        {enchantmentsData.map((ench, idx) => (
          <option value={idx}>
            {ench.name === "Sin Encantamiento" ? "Sin Encantamiento" : `[${ench.rarity}] ${ench.name}`}
          </option>
        ))}
      </select>
    </div>

  </div>

  <!-- 3. TABLERO DE RENDIMIENTO FÍSICO Y TIEMPOS -->
  <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-3 text-center">
    
    <div class="bg-neutral-900/90 border border-amber-500/20 p-3 rounded-xl">
      <span class="text-[10px] font-bold text-amber-400 uppercase block">Suerte Total</span>
      <span id="stat-luck" class="text-xl font-black text-amber-300">0</span>
    </div>

    <div class="bg-neutral-900/90 border border-cyan-500/20 p-3 rounded-xl">
      <span class="text-[10px] font-bold text-cyan-400 uppercase block">Atracción</span>
      <span id="stat-attraction" class="text-xl font-black text-cyan-300">0%</span>
    </div>

    <div class="bg-neutral-900/90 border border-sky-500/20 p-3 rounded-xl">
      <span class="text-[10px] font-bold text-sky-400 uppercase block">Tiempo Ciclo</span>
      <span id="stat-cycle" class="text-xl font-black text-white">0s</span>
    </div>

    <div class="bg-neutral-900/90 border border-emerald-500/20 p-3 rounded-xl">
      <span class="text-[10px] font-bold text-emerald-400 uppercase block">Capturas / Hora</span>
      <span id="stat-catches-hr" class="text-xl font-black text-emerald-400">0</span>
    </div>

    <div class="bg-neutral-900/90 border border-purple-500/20 p-3 rounded-xl">
      <span class="text-[10px] font-bold text-purple-400 uppercase block">Max Weight</span>
      <span id="stat-weight" class="text-xl font-black text-purple-300">0 kg</span>
    </div>

    <div class="bg-neutral-900/90 border border-orange-500/20 p-3 rounded-xl">
      <span class="text-[10px] font-bold text-orange-400 uppercase block">Big Catch Shift</span>
      <span id="stat-bigcatch" class="text-xl font-black text-orange-300">+0</span>
    </div>

  </div>

  <!-- 4. DISTRIBUCIÓN DE PROBABILIDADES DE APARICIÓN POR SUERTE -->
  <div class="bg-neutral-900/85 border border-white/10 p-5 rounded-2xl">
    <div class="flex justify-between items-center mb-4">
      <div>
        <h3 class="text-lg font-bold text-white">Probabilidades de Captura por Rareza</h3>
        <p class="text-xs text-slate-400">Calculado con la curva de Suerte Exponencial de tu Build actual.</p>
      </div>
      <span id="luck-mult-badge" class="text-xs font-bold px-2.5 py-1 rounded bg-amber-400/10 text-amber-300 border border-amber-400/20">
        Multiplier: 1.00x
      </span>
    </div>

    <!-- Grid de Porcentajes -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3" id="rarity-rates-grid">
      <!-- Renders dinámicos vía JS -->
    </div>
  </div>

</div>

<script>
  import { rodsData, linesData, bobbersData } from '../data/gear';
  import { enchantmentsData } from '../data/enchantments';
  import { RARITY_BASE_WEIGHTS, RARITY_SCALE_FACTORS, calculateFishingCycle } from '../utils/engine';

  function parseStat(str: string | undefined): number {
    if (!str || str === '-') return 0;
    return parseFloat(str.replace('%', '').replace('+', '').replace(/,/g, '').trim()) || 0;
  }

  function parseWeight(str: string | undefined): number {
    if (!str || str === '-') return 0;
    return parseFloat(str.toLowerCase().replace('kg', '').replace(/,/g, '').replace('+', '').trim()) || 0;
  }

  const elRod = document.getElementById('select-rod') as HTMLSelectElement;
  const elLine = document.getElementById('select-line') as HTMLSelectElement;
  const elBobber = document.getElementById('select-bobber') as HTMLSelectElement;
  const elEnchant = document.getElementById('select-enchant') as HTMLSelectElement;
  const elIslands = document.getElementById('islands-completed') as HTMLInputElement;

  const statLuck = document.getElementById('stat-luck')!;
  const statAttraction = document.getElementById('stat-attraction')!;
  const statCycle = document.getElementById('stat-cycle')!;
  const statCatchesHr = document.getElementById('stat-catches-hr')!;
  const statWeight = document.getElementById('stat-weight')!;
  const statBigCatch = document.getElementById('stat-bigcatch')!;
  const luckBadge = document.getElementById('luck-mult-badge')!;
  const rarityGrid = document.getElementById('rarity-rates-grid')!;

  const rarityColorMap: Record<string, string> = {
    Trash: "border-slate-700 bg-slate-900/40 text-slate-400",
    Abundant: "border-slate-500/30 bg-slate-800/30 text-slate-300",
    Common: "border-emerald-500/30 bg-emerald-950/20 text-emerald-300",
    Curious: "border-sky-500/30 bg-sky-950/20 text-sky-300",
    Elusive: "border-amber-500/30 bg-amber-950/20 text-amber-300",
    Fabled: "border-rose-500/30 bg-rose-950/20 text-rose-300",
    Mythic: "border-purple-500/30 bg-purple-950/20 text-purple-300",
    Exotic: "border-yellow-400/40 bg-yellow-950/20 text-amber-200 font-bold",
    Relic: "border-teal-500/30 bg-teal-950/20 text-teal-300",
    Secret: "border-indigo-500/40 bg-indigo-950/30 text-indigo-200",
    UltimateSecret: "border-pink-500/40 bg-pink-950/30 text-pink-200 font-bold"
  };

  function updateDashboard() {
    const rod = rodsData[parseInt(elRod.value)];
    const line = linesData[parseInt(elLine.value)];
    const bobber = bobbersData[parseInt(elBobber.value)];
    const enchIdx = parseInt(elEnchant.value);
    const ench = (enchIdx >= 0 && enchantmentsData[enchIdx]) ? enchantmentsData[enchIdx] : enchantmentsData[0];
    const islandBonus = (parseInt(elIslands.value) || 0) * 15;

    // Sumatoria de Stats
    const totalLuck = parseStat(rod.luck) + parseStat(line.luck) + parseStat(bobber.luck) + (ench ? parseStat(ench.luck) : 0) + islandBonus;
    const totalAttraction = Math.min(100, Math.max(0, parseStat(rod.attractionRate) + parseStat(line.attractionRate) + parseStat(bobber.attractionRate) + (ench ? parseStat(ench.attractionRate) : 0)));
    const totalBigCatch = parseStat(rod.bigCatchRate) + parseStat(line.bigCatchRate) + parseStat(bobber.bigCatchRate) + (ench ? parseStat(ench.bigCatchRate) : 0);
    const totalWeight = parseWeight(rod.maxWeight) + (ench ? parseWeight(ench.maxWeight) : 0);

    // Cálculos de Ciclo
    const { cycleTimeSec, catchesPerHour } = calculateFishingCycle(totalAttraction);

    // Actualizar Textos
    statLuck.textContent = `${totalLuck >= 0 ? '+' : ''}${totalLuck}`;
    statAttraction.textContent = `${totalAttraction}%`;
    statCycle.textContent = `${cycleTimeSec}s`;
    statCatchesHr.textContent = `${catchesPerHour}`;
    statWeight.textContent = `${totalWeight.toLocaleString()} kg`;
    statBigCatch.textContent = `${totalBigCatch >= 0 ? '+' : ''}${totalBigCatch}`;

    // Cálculo del Motor de Suerte Exponencial
    const luckMultiplier = Math.max(0.01, 1 + (totalLuck / 100));
    luckBadge.textContent = `Multiplier: ${luckMultiplier.toFixed(2)}x`;

    let totalPoolWeight = 0;
    const adjustedWeights: Record<string, number> = {};

    for (const [rarity, baseW] of Object.entries(RARITY_BASE_WEIGHTS)) {
      const exponent = RARITY_SCALE_FACTORS[rarity] || 0;
      const effectiveWeight = baseW * Math.pow(luckMultiplier, exponent);
      adjustedWeights[rarity] = effectiveWeight;
      totalPoolWeight += effectiveWeight;
    }

    // Renderizar Grid de Rarezas
    rarityGrid.innerHTML = '';
    for (const [rarity, weight] of Object.entries(adjustedWeights)) {
      const percentage = ((weight / totalPoolWeight) * 100);
      const formatted = percentage < 0.01 ? percentage.toFixed(4) : percentage.toFixed(2);

      const card = document.createElement('div');
      card.className = `p-2.5 rounded-xl border flex flex-col justify-between text-center ${rarityColorMap[rarity] || 'border-neutral-800'}`;
      card.innerHTML = `
        <span class="text-[10px] uppercase font-bold tracking-wider">${rarity}</span>
        <span class="text-base font-black my-1">${formatted}%</span>
        <span class="text-[9px] text-slate-500">Base: ${RARITY_BASE_WEIGHTS[rarity]}%</span>
      `;
      rarityGrid.appendChild(card);
    }
  }

  [elRod, elLine, elBobber, elEnchant, elIslands].forEach(el => el?.addEventListener('change', updateDashboard));
  elIslands?.addEventListener('input', updateDashboard);

  // Inicializar
  updateDashboard();
</script>